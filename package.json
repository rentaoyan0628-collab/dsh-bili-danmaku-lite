{
  "name": "dsh-bili-danmaku-lite",
  "version": "0.4.4",
  "description": "DSH 轻量 B站直播弹幕插件：看弹幕、授权发弹幕、挂机听、可选 AI 自动陪聊与可选语音转写；不常驻重进程，闲时几乎不占 CPU。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rentaoyan0628-collab/dsh-bili-danmaku-lite.git"
  },
  "homepage": "https://github.com/rentaoyan0628-collab/dsh-bili-danmaku-lite#readme",
  "bugs": {
    "url": "https://github.com/rentaoyan0628-collab/dsh-bili-danmaku-lite/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "python",
    "docs",
    "README.md",
    "LICENSE",
    "requirements.txt"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "bilibili-live",
    "danmaku",
    "ai-chatbot",
    "live-chat",
    "lite",
    "lightweight"
  ]
}
